<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <!--
    RandomChar IME MSI installer (WiX v3).
    Build with:
      candle.exe -dBinDir=<path-to-exe-dir> Product.wxs
      light.exe  -out RandomCharIME.msi Product.wixobj
  -->

  <Product Id="*"
           Name="RandomChar IME"
           Language="1033"
           Version="1.0.0"
           Manufacturer="RandomChar IME"
           UpgradeCode="A3B2C1D0-E4F5-4A8B-9C0D-EF1234567890">

    <Package InstallerVersion="200"
             Compressed="yes"
             InstallScope="perMachine"
             Manufacturer="RandomChar IME"
             Description="RandomChar IME Installer" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of RandomChar IME is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- ---- Features ---- -->
    <Feature Id="ProductFeature" Title="RandomChar IME" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- ---- Directory layout ---- -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="RandomChar IME" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ProgramMenuDir" Name="RandomChar IME" />
      </Directory>
      <Directory Id="DesktopFolder" />
    </Directory>

    <!-- ---- Main executable ---- -->
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="*">
        <File Id="RandomCharIME.exe"
              Source="$(var.BinDir)\RandomCharIME.exe"
              KeyPath="yes"
              Checksum="yes" />
      </Component>
    </DirectoryRef>

    <!-- ---- Start Menu shortcut ---- -->
    <DirectoryRef Id="ProgramMenuDir">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="StartMenuShortcut"
                  Name="RandomChar IME"
                  Description="Random character input method editor"
                  Target="[INSTALLFOLDER]RandomCharIME.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveProgramMenuDir" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\RandomCharIME"
                       Name="StartMenuInstalled"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- ---- Desktop shortcut ---- -->
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*">
        <Shortcut Id="DesktopShortcut"
                  Name="RandomChar IME"
                  Description="Random character input method editor"
                  Target="[INSTALLFOLDER]RandomCharIME.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU"
                       Key="Software\RandomCharIME\Desktop"
                       Name="DesktopInstalled"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

  </Product>
</Wix>
